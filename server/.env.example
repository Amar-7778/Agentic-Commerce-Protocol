# ─────────────────────────────────────────────────────────────────────────────
# AgenticCommerce — environment template
# Copy to `.env` and fill in. Never commit the resulting `.env`.
# Every value below is optional: the system boots with safe defaults and
# degrades gracefully when a credential is absent.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated allowlist. Use "*" only for local development.
CORS_ORIGINS=*

# ── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use the embedded PGlite (WASM Postgres 16) engine.
# Set to a connection string to target a real PostgreSQL cluster.
DATABASE_URL=

# ── Commerce ─────────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=INR
# GST as a fraction: 0.18 == 18%. Drives every tax figure, server and client.
TAX_RATE=0.18
# Identity assumed when a request carries no user. Demo convenience only.
DEMO_USER_ID=user_alex_buyer

# ── Governance gate ──────────────────────────────────────────────────────────
# Above this, an autonomous agent needs human step-up approval.
GOV_AUTONOMOUS_STEP_UP_THRESHOLD=35000
# Absolute per-transaction ceiling. A supervisor cannot override this.
GOV_HARD_PER_TRANSACTION_CEILING=50000
# Applied when a subject has no row in `spending_limits`.
GOV_DEFAULT_SPEND_CAP=100000
# Largest markdown a merchant agent may launch unreviewed.
GOV_MAX_DISCOUNT_PERCENTAGE=40
# Minutes a pre-authorization token stays valid.
GOV_PREAUTH_TTL_MINUTES=30

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Test keys start with rzp_test_. Get yours at dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_PAYMENT_LINK_TTL_HOURS=24
# Master switch for outbound calls to Razorpay. Keep false to stay entirely on
# the deterministic test-rail simulator even when credentials are present.
RAZORPAY_LIVE_API_ENABLED=false

# ── Swiggy Builders Club (optional) ──────────────────────────────────────────
# Without a token the adapter serves its sandbox cloud-kitchen fixtures.
SWIGGY_AUTH_TOKEN=
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com
SWIGGY_REQUEST_TIMEOUT_MS=8000
# Guards real-money dispatch. Keep false during evaluation.
SWIGGY_LIVE_CHECKOUT_ENABLED=false

# ── Groq LLM (optional) ──────────────────────────────────────────────────────
# Without a key the agent falls back to the deterministic catalog engine,
# which is fully functional offline. Get a key at console.groq.com
# GROQ_MODEL must be a model Groq currently serves AND that supports tool
# calling. Check the live list with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Note: the llama-3.1 / llama-3.3 families have been retired by Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=10000
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=1024
GROQ_MAX_TOOL_TURNS=4
GROQ_HISTORY_WINDOW=4

# ── Recommendations ──────────────────────────────────────────────────────────
RECOMMENDATION_DEFAULT_LIMIT=6
RECOMMENDATION_UPSELL_LIMIT=4
RECOMMENDATION_REORDER_LOOKBACK=5
CONVERSATIONAL_RESULT_LIMIT=3
