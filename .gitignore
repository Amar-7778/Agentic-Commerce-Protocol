# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment & secrets — never commit real credentials
.env
.env.local
.env.*.local

# Embedded database state (regenerated by `npm run seed`)
server/data/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# OpenCode CLI config — contains a plaintext apiKey, never commit it
opencode.json
opencode.jsonc

# Local Claude Code settings — machine-specific, may contain permission
# allowlist entries with credentials
.claude/settings.local.json

# Vite dependency cache
.vite/
